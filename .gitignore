# Ignore everything at repository root by default
/*

# Keep required project paths
!.gitignore
!/.cursor/
!/.cursor/**
!/docs/
!/docs/**
!/icon/
!/icon/**
!/larix_nexus/
!/larix_nexus/**
!/telegram_bot/
!/telegram_bot/**
!/main.py
!/build.bat
!/Larix_Nexus.spec
!/*.md
!/pytest.ini

# Environment / secrets — override whitelist
.env
**/.env
*.env

# Common generated/runtime artifacts
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
nul
**/nul
*.nul
**/*.tmp
**/.DS_Store
**/Thumbs.db

# Build output
dist/
build/

# Pytest runtime state (kept inside the test workspace, never committed)
/larix_nexus/tests/.runtime/
