# The repository root is allow-listed explicitly below.
/*

# Published project files
!/.gitignore
!/README.md
!/main.py
!/pytest.ini
!/build.bat
!/Larix_Nexus.spec
!/requirements*.txt
!/pyproject.toml
!/poetry.lock
!/LICENSE
!/LICENSE.*
!/larix_nexus/
!/larix_nexus/**
!/icon/
!/icon/**
!/telegram_bot/
!/telegram_bot/**
!/.cursor/
!/.cursor/**

# Generated caches and test runtime state
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/

# Logs, local databases and temporary files
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.db
**/*.sqlite
**/*.sqlite3
**/.env
**/.env.*
!.env.example
!**/.env.example
**/.venv/
**/venv/
**/env/
**/.tokensave/
**/.runtime/

# Build output and local working materials
build/
dist/
artifacts/
screen/
Nexus_downloads/
LarixNexus_backup_*/
test-data/
*.har
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Local tool state and Windows/system files
.agents/
.codex/
.serena/
.tokensave/
.obsidian/
nul
**/nul
*.nul
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
