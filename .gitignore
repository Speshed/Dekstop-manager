# Ignore everything at repository root by default
/*

# Keep only required project paths
!.gitignore
!/icon/
!/icon/**
!/larix_nexus/
!/larix_nexus/**
!/telegram_bot/
!/telegram_bot/**
!/main.py

# Ignore common generated/runtime artifacts
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.tmp
**/.DS_Store
**/Thumbs.db
